{
  "name": "futter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs",
    "test:shared": "node test/shared-browser.mjs",
    "test:calendar": "node test/calendar-browser.mjs",
    "test:recipes": "node test/recipe-snack-browser.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "memorystore": "^1.6.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "vite": "^8.3.8"
  }
}
