[Unit]
Description=Block connections initiated by the Futter app user
After=ufw.service
Before=futter.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/futter/egress.nft
ExecReload=/usr/sbin/nft -f /etc/futter/egress.nft
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN
# No ExecStop: removing the unit must not silently open app egress.
