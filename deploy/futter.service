[Unit]
Description=Futter private dinner planner
After=network.target

[Service]
Type=simple
User=futter
Group=futter
WorkingDirectory=/opt/futter
EnvironmentFile=/etc/futter/server.env
Environment=FUTTER_DATA_DIR=/var/lib/futter
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
StateDirectory=futter
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/futter
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64
CPUQuota=100%

[Install]
WantedBy=multi-user.target
